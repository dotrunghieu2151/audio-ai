{
  "version": 10,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "description": "Build the project with Ninja Multi-Config",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/.build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/default.cmake",
        "CMAKE_EXPORT_COMPLE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_FAST": "ON"
      },
      "environment": {
        "PATH": "$penv{PATH}",
        "SLINT_LIVE_PREVIEW": "1",
        "VCPKG_ROOT": "$env{HOME}/.vcpkg"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "default",
      "displayName": "Windows (MSVC)",
      "description": "This build is only available on Windows with MSVC compiler",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_CXX_FLAGS_INIT": "/W4 /permissive- /EHsc /Zc:__cplusplus /utf-8",
        "CMAKE_GENERATOR_PLATFORM": "x64",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CMAKE_CXX_FLAGS_DEBUG_INIT": "/Od /Zi /MTd /DDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE_INIjT": "/O2 /DNDEBUG /GL /Gw",
        "CMAKE_CXX_FLAGS_FAST_INIT": "/Ox /Ot /Oi /GL /Gw /fp:fast /DNDEBUG"
      }
    },
    {
      "name": "windows-clang",
      "inherits": "default",
      "displayName": "Windows (Clang)",
      "description": "This build is only available on Windows with clang-cl (MSVC compatible mode)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_CXX_FLAGS_INIT": "-Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wno-unused-parameter",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER": "lld-link",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CMAKE_CXX_FLAGS_DEBUG_INIT": "-O0 -g3 -DDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE_INIT": "-O3 -DNDEBUG -march=native",
        "CMAKE_CXX_FLAGS_FAST_INIT": "-Ofast -DNDEBUG -march=native -funroll-loops -ffast-math"
      }
    },
    {
      "name": "linux-clang",
      "inherits": "default",
      "displayName": "Linux (Clang)",
      "description": "This build is only available on Linux (Clang)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS_INIT": "-Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wno-unused-parameter -fPIC",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_CXX_FLAGS_DEBUG_INIT": "-O0 -g3 -DDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE_INIT": "-O3 -DNDEBUG -march=native -mtune=native",
        "CMAKE_CXX_FLAGS_FAST_INIT": "-Ofast -DNDEBUG -march=native -mtune=native -funroll-loops -ffast-math"
      }
    },
    {
      "name": "linux-gcc",
      "inherits": "default",
      "displayName": "Linux (GCC)",
      "description": "This build is only available on Linux (GCC)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS_INIT": "-Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wno-unused-parameter -fPIC",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_CXX_FLAGS_DEBUG_INIT": "-O0 -g3 -DDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE_INIT": "-O3 -DNDEBUG -march=native -mtune=native",
        "CMAKE_CXX_FLAGS_FAST_INIT": "-Ofast -DNDEBUG -march=native -mtune=native -funroll-loops -ffast-math"
      }
    },
    {
      "name": "macos",
      "inherits": "default",
      "displayName": "MacOS",
      "description": "This build is only available on MacOS (Clang)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Darwin",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_CXX_FLAGS_INIT": "-Wall -Wextra -Wpedantic -Wshadow -Wconversion -fvisibility=hidden -fPIC",
        "CMAKE_CXX_FLAGS_DEBUG_INIT": "-O0 -g3 -DDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE_INIT": "-O3 -DNDEBUG -march=native -mtune=native",
        "CMAKE_CXX_FLAGS_FAST_INIT": "-Ofast -DNDEBUG -march=native -mtune=native -funroll-loops -ffast-math"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "displayName": "Debug",
      "description": "Build the project with Ninja in Debug mode on Windows",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "displayName": "Release",
      "description": "Build the project with Ninja in Release mode on Windows",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-fast",
      "configurePreset": "windows-msvc",
      "displayName": "Fast",
      "description": "Build the project with Ninja in Fast mode on Windows",
      "configuration": "Fast"
    },
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang",
      "displayName": "Debug",
      "description": "Build the project with Ninja in Debug mode on Windows with clang-cl",
      "configuration": "Debug"
    },
    {
      "name": "windows-clang-release",
      "configurePreset": "windows-clang",
      "displayName": "Release",
      "description": "Build the project with Ninja in Release mode on Windows with clang-cl",
      "configuration": "Release"
    },
    {
      "name": "windows-clang-fast",
      "configurePreset": "windows-clang",
      "displayName": "Fast",
      "description": "Build the project with Ninja in Fast mode on Windows with clang-cl",
      "configuration": "Fast"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang",
      "displayName": "Debug",
      "description": "Build the project with Ninja in Debug mode on Linux",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang",
      "displayName": "Release",
      "description": "Build the project with Ninja in Release mode on Linux",
      "configuration": "Release"
    },
    {
      "name": "linux-clang-fast",
      "configurePreset": "linux-clang",
      "displayName": "Fast",
      "description": "Build the project with Ninja in Fast mode on Linux",
      "configuration": "Fast"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos",
      "displayName": "Debug",
      "description": "Build the project with Ninja in Debug mode on MacOS",
      "configuration": "Debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos",
      "displayName": "Release",
      "description": "Build the project with Ninja in Release mode on MacOS",
      "configuration": "Release"
    },
    {
      "name": "macos-fast",
      "configurePreset": "macos",
      "displayName": "Fast",
      "description": "Build the project with Ninja in Fast mode on MacOS",
      "configuration": "Fast"
    }
  ],
  "testPresets": [
    {
      "name": "default-test",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "windows-msvc-test",
      "configurePreset": "windows-msvc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "windows-clang-test",
      "configurePreset": "windows-clang",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "linux-clang-test",
      "configurePreset": "linux-clang",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "macos-test",
      "configurePreset": "macos",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "zip",
      "configurePreset": "default",
      "generators": ["TGZ"]
    },
    {
      "name": "windows-wix",
      "configurePreset": "windows-msvc",
      "generators": ["WIX"]
    },
    {
      "name": "linux-deb",
      "configurePreset": "linux-clang",
      "generators": ["DEB"]
    },
    {
      "name": "macos-dmg",
      "configurePreset": "macos",
      "generators": ["DMG"]
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-clang-debug",
      "steps": [
        {
          "type": "configure",
          "name": "linux-clang"
        },
        {
          "type": "build",
          "name": "linux-clang-debug"
        }
      ]
    }
  ]
}
